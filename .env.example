# Dream Labs API key. Paste it after the = sign, no quotes, no spaces. This file is gitignored; never commit it.
# The Dream client reads DREAM_API_KEY from the environment; the harness loads this file with python-dotenv.
DREAM_API_KEY=dl_live_...   # your team key

# Optional: the service addresses, printed on the platform's Fine-tuning page. Leave empty to use the defaults.
DREAM_GATEWAY_URL=
DREAM_API_URL=
DREAM_DATA_URL=
